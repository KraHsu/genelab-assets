<mujoco model="genelab_franka_panda">
  <!--
    Minimal Franka Emika Panda kinematic stub for GeneLab's asset_zoo entry. Joint
    names match the MuJoCo Menagerie reference (`panda_joint1..7`,
    `panda_finger_joint1..2`) so the gain dictionary in
    `genelab.asset_zoo.franka.FrankaPandaCfg` resolves correctly. Geometry is
    intentionally simplified to capsule primitives — replace with the Menagerie
    panda.xml + meshes for visual fidelity.
  -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint armature="0.1" damping="0.5"/>
    <geom contype="0" conaffinity="0" rgba="0.85 0.85 0.85 1"/>
  </default>
  <worldbody>
    <body name="link0">
      <geom type="capsule" fromto="0 0 0 0 0 0.14" size="0.06"/>
      <body name="link1" pos="0 0 0.14">
        <joint name="panda_joint1" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.19" size="0.05"/>
        <body name="link2" pos="0 0 0.19">
          <joint name="panda_joint2" type="hinge" axis="0 1 0" range="-1.7628 1.7628"/>

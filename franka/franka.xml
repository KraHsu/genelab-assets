          <body name="link3" pos="0 0 0.20">
            <joint name="panda_joint3" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
            <geom type="capsule" fromto="0 0 0 0.08 0 0" size="0.045"/>
            <body name="link4" pos="0.08 0 0">
              <joint name="panda_joint4" type="hinge" axis="0 1 0" range="-3.0718 -0.0698"/>
              <geom type="capsule" fromto="0 0 0 0 0 0.20" size="0.045"/>
              <body name="link5" pos="0 0 0.20">
                <joint name="panda_joint5" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.18" size="0.04"/>
                <body name="link6" pos="0 0 0.18">
                  <joint name="panda_joint6" type="hinge" axis="0 1 0" range="-0.0175 3.7525"/>
                  <geom type="capsule" fromto="0 0 0 0.06 0 0" size="0.035"/>
                  <body name="link7" pos="0.06 0 0">
                    <joint name="panda_joint7" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.10" size="0.03"/>
                    <body name="hand" pos="0 0 0.10">
                      <geom type="box" size="0.04 0.04 0.02"/>
                      <body name="finger_left" pos="0 0 0.02">
                        <joint name="panda_finger_joint1" type="slide" axis="0 1 0" range="0 0.04"/>
                        <geom type="box" size="0.01 0.005 0.025"/>
                      </body>
                      <body name="finger_right" pos="0 0 0.02">
                        <joint name="panda_finger_joint2" type="slide" axis="0 -1 0" range="0 0.04"/>
                        <geom type="box" size="0.01 0.005 0.025"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="panda_joint1_motor" joint="panda_joint1" gear="1"/>
    <motor name="panda_joint2_motor" joint="panda_joint2" gear="1"/>
    <motor name="panda_joint3_motor" joint="panda_joint3" gear="1"/>
    <motor name="panda_joint4_motor" joint="panda_joint4" gear="1"/>
    <motor name="panda_joint5_motor" joint="panda_joint5" gear="1"/>
    <motor name="panda_joint6_motor" joint="panda_joint6" gear="1"/>
    <motor name="panda_joint7_motor" joint="panda_joint7" gear="1"/>
    <motor name="panda_finger_joint1_motor" joint="panda_finger_joint1" gear="1"/>
